# ==============================================================================
# PathoGuard-AI Root Git & Distribution Ignore Configuration
# Enforces clean source packaging without secrets, binaries, or databases.
# ==============================================================================

# 1. Environment Secrets & Configuration Files
.env
.env.local
.env.*.local
*.env
!*.example

# 2. Virtual Environments & Python Binaries
.venv/
venv/
env/
ENV/
*.pyc
__pycache__/
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 3. Persistent Databases & Local SQLite Stores
*.db
*.sqlite
*.sqlite3
PathoGuard-AI-Backend/data/*.db
!PathoGuard-AI-Backend/data/.gitkeep

# 4. Uploaded Diagnostic Documents & Transient Artifacts
PathoGuard-AI-Backend/uploads/*
!PathoGuard-AI-Backend/uploads/.gitkeep
PathoGuard-AI-Backend/tests/temp_*

# 5. Application & Server Logs
*.log
logs/
.system_generated/

# 6. IDEs & Operating System Artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db

# 7. Distribution ZIPs & Local Backups
*.zip
*.tar.gz
*.bak
*.tmp

# PathoGuard-AI Production Environment Variables (.env.production)
# DO NOT commit real secrets to version control. Load from Secret Manager in CI/CD.

PROJECT_NAME="PathoGuard Clinical Intelligence API"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=False
API_V1_STR="/api/v1"

# Security & Secret Keys
SECRET_KEY="GENERATE_A_64_CHAR_HEX_KEY_USING_OPENSSL_RAND_HEX_32"
ALLOWED_HOSTS=["api.pathoguard.ai", "pathoguard.ai"]

# Production CORS — Restricted strictly to production web domain
ALLOWED_ORIGINS=["https://app.pathoguard.ai", "https://pathoguard.ai"]

# Database Configuration (PostgreSQL managed instance, e.g. Cloud SQL / RDS)
DATABASE_URL="postgresql://pathoguard_user:SECURE_DB_PASSWORD@127.0.0.1:5432/pathoguard_prod"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Document Upload Sandbox & Limits
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB
UPLOAD_SANDBOX_PATH="/var/data/pathoguard/sandbox"

# Rate Limiting & Health
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL="INFO"

# PathoGuard-AI Staging Environment Variables (.env.staging)

PROJECT_NAME="PathoGuard Clinical Intelligence API (Staging)"
VERSION="1.0.0-rc1"
ENVIRONMENT="staging"
DEBUG=False
API_V1_STR="/api/v1"

# Security
SECRET_KEY="STAGING_ENVIRONMENT_SECRET_KEY_REPLACE_IN_PIPELINE"
ALLOWED_HOSTS=["staging-api.pathoguard.ai"]

# Staging CORS
ALLOWED_ORIGINS=["https://staging-app.pathoguard.ai"]

# Database Configuration (Staging PostgreSQL or persistent SQLite)
DATABASE_URL="postgresql://pathoguard_staging:STAGING_PASS@127.0.0.1:5432/pathoguard_staging"

# Document Upload Sandbox
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB
UPLOAD_SANDBOX_PATH="/var/data/pathoguard_staging/sandbox"
LOG_LEVEL="INFO"

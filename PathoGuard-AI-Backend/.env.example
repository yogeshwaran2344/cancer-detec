# PathoGuard-AI Backend Environment Configuration
PROJECT_NAME="PathoGuard Clinical Intelligence API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Allowed CORS Origins (Comma-separated or JSON list)
# Restrict to local development frontend origins (e.g. VS Code Live Server)
ALLOWED_ORIGINS=["http://127.0.0.1:5500","http://localhost:5500","http://127.0.0.1:8000","http://localhost:8000","http://127.0.0.1:3000","http://localhost:3000"]

# File upload limits (in bytes: 25 MB default)
MAX_UPLOAD_SIZE_BYTES=26214440
